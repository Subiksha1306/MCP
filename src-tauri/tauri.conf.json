{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "http://localhost:1420",
    "distDir": "../ui",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Nexus Server",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": false,
        "ask": true,
        "confirm": true,
        "message": true,
        "open": true,
        "save": true
      },
      "fs": {
        "all": true,
        "scope": ["$APPDATA", "$DESKTOP", "$DOCUMENT", "$DOWNLOAD", "$PICTURE", "$VIDEO"]
      },
      "path": {
        "all": true
      },
      "os": {
        "all": true
      },
      "http": {
        "all": true,
        "scope": ["https://*.sharepoint.com", "https://*.dynamics.com", "https://*.crm.dynamics.com", "https://api.anthropic.com"]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.nexus.server",
      "icon": []
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "Nexus Server",
        "width": 1200,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  }
}